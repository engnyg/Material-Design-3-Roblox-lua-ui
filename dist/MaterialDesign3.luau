			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
			ZIndex = 51,
			Parent = textColumn,
		}
		Typography.Apply(body, "BodyMedium")
		themer:Bind(body, { TextColor3 = "OnSurfaceVariant" })
