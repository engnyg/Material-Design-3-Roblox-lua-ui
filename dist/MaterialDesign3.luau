	local hasIcon = props.Icon ~= false and Base.CanShowIcon(iconName)
	if hasIcon then
		local icon = Base.Glyph(themer, iconName, 20, "Primary", card, props.Image == nil)
		icon.ZIndex = 51
		hasIcon = icon.Visible
	end

	local textColumn = Create("Frame") {
		Name = "Text",
