loaders[newNode("Dialog", N_Components)] = function(script, require)
--[[
	Material 3 Basic Dialog: scrim + centered card with title/text/actions.

	local dialog = MD3.Dialog.new({
		Parent = screenGui,
		Title = "Delete item?",
		Text = "This action cannot be undone.",
