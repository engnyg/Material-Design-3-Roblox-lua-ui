		LayoutOrder = self._count,
		ZIndex = 50,
		Parent = self.Instance,
	}

	local card = Create("TextButton") {
		Name = "Card",
		AutoButtonColor = false,
		Text = "",
		Position = UDim2.new(1, 24, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
