function Slider:SetDisabled(disabled: boolean)
	self._disabled = disabled
	self._handleArea.Active = not disabled
	self:_render(true)
end

function Slider:SetTheme(theme)
	self._theme = theme
	self:_render(true)
end

function Slider:Destroy()
	self._maid:Destroy()
