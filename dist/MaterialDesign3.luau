	local content = Create("Frame") {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = self._extended and UDim2.new(0, 0, 1, 0) or UDim2.fromScale(1, 1),
		AutomaticSize = self._extended and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
		Parent = button,
