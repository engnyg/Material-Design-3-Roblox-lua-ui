		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	}
	Typography.Apply(label, "LabelLarge")

	self._button = button
	self._icon = icon
	self._label = label
	self._stateLayer = stateLayer

	local page = Create("ScrollingFrame") {
		Name = self.Title,
		BackgroundTransparency = 1,
